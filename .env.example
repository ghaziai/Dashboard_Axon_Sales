# Pengaturan proyek Supabase — lihat:
# https://supabase.com/dashboard/project/_/settings/api
#
# Publik — aman untuk diekspos ke browser; akses dikontrol oleh kebijakan
# Row Level Security (RLS) pada setiap tabel, bukan dengan merahasiakan kunci ini.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Khusus server — JANGAN PERNAH menggunakan awalan NEXT_PUBLIC_,
# JANGAN PERNAH mengimpor ke dalam kode Client Component,
# JANGAN PERNAH melakukan commit nilai aslinya. Melewati RLS.
SUPABASE_SERVICE_ROLE_KEY=